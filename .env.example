# SQL Server shown in the setup screenshot
SQL_SERVER_HOST=192.168.1.69
SQL_SERVER_PORT=1433
SQL_SERVER_DATABASE=ITmanager
SQL_SERVER_INSTANCE=
SQL_SERVER_DRIVER=ODBC Driver 18 for SQL Server

# windows = Windows Authentication; sql = SQL Server username/password
SQL_SERVER_AUTH=windows
SQL_SERVER_USER=
SQL_SERVER_PASSWORD=

# Optional: use a SQLAlchemy URL instead of the SQL_SERVER_* settings.
# Example: mssql+pyodbc://user:password@192.168.1.69/ITmanager?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# DATABASE_URL=
